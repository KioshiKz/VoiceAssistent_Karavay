DATABASE_URL=postgresql+asyncpg://karavay:karavay@localhost:5432/karavay
# Relative to backend/, regardless of the current working directory.
DATABASE_SNAPSHOT_PATH=data/karavay.sql
JWT_SECRET=change-me-local-dev
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
FRONTEND_ORIGIN=http://localhost:5173
INITIAL_ADMIN_EMAIL=admin@karavay.app
INITIAL_ADMIN_PASSWORD=change-me-now

# MERTECH M-ER 326: CAS-M (passive), 9600 baud, 8N1.
# auto selects a single USB serial adapter; COM1 is never selected automatically.
SCALE_PORT=auto
SCALE_BAUDRATE=9600

# Read-only 1C OData reference synchronization (optional).
ONEC_ODATA_URL=
ONEC_ODATA_USER=
ONEC_ODATA_PASSWORD=
