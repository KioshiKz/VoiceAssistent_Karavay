// Read-only export for БухгалтерияДляКазахстана 2.0.4.7.
// Executed only against a restored local copy. No business objects are written.

Функция Идентификатор(Ссылка)
    Возврат Строка(Ссылка.УникальныйИдентификатор());
КонецФункции

Функция ВыгрузитьЕдиницы()
    Результат = Новый Массив;
    Выборка = Справочники.КлассификаторЕдиницИзмерения.Выбрать();
    Пока Выборка.Следующий() Цикл
        Запись = Новый Структура;
        Запись.Вставить("ref", Идентификатор(Выборка.Ссылка));
        Запись.Вставить("code", Выборка.Код);
        Запись.Вставить("name", Выборка.Наименование);
        Запись.Вставить("full_name", Выборка.НаименованиеПолное);
        Запись.Вставить("deleted", Выборка.ПометкаУдаления);
        Результат.Добавить(Запись);
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция ВыгрузитьНоменклатуру()
    Результат = Новый Массив;
    Выборка = Справочники.Номенклатура.Выбрать();
    Пока Выборка.Следующий() Цикл
        Запись = Новый Структура;
        Запись.Вставить("ref", Идентификатор(Выборка.Ссылка));
        Запись.Вставить("code", Выборка.Код);
        Запись.Вставить("name", Выборка.Наименование);
        Запись.Вставить("parent_ref", Идентификатор(Выборка.Родитель));
        Запись.Вставить("is_group", Выборка.ЭтоГруппа);
        Запись.Вставить("deleted", Выборка.ПометкаУдаления);
        Если НЕ Выборка.ЭтоГруппа Тогда
            Запись.Вставить("unit_ref", Идентификатор(Выборка.БазоваяЕдиницаИзмерения));
            Запись.Вставить("full_name", Выборка.НаименованиеПолное);
            Запись.Вставить("article", Выборка.Артикул);
            Запись.Вставить("is_service", Выборка.Услуга);
            Запись.Вставить("kind", Строка(Выборка.ВидНоменклатуры));
            Запись.Вставить("bread_weight", Выборка.ВесХлебов);
        КонецЕсли;
        Результат.Добавить(Запись);
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция ВыгрузитьСпецификации()
    Результат = Новый Массив;
    Выборка = Справочники.СпецификацииНоменклатуры.Выбрать();
    Пока Выборка.Следующий() Цикл
        Если Выборка.ЭтоГруппа Тогда
            Продолжить;
        КонецЕсли;
        Запись = Новый Структура;
        Запись.Вставить("ref", Идентификатор(Выборка.Ссылка));
        Запись.Вставить("code", Выборка.Код);
        Запись.Вставить("name", Выборка.Наименование);
        Запись.Вставить("product_ref", Идентификатор(Выборка.Владелец));
        Запись.Вставить("quantity", Выборка.Количество);
        Запись.Вставить("deleted", Выборка.ПометкаУдаления);
        Компоненты = Новый Массив;
        Для Каждого СтрокаСостава Из Выборка.Ссылка.ИсходныеКомплектующие Цикл
            Компонент = Новый Структура;
            Компонент.Вставить("item_ref", Идентификатор(СтрокаСостава.Номенклатура));
            Компонент.Вставить("quantity", СтрокаСостава.Количество);
            Компоненты.Добавить(Компонент);
        КонецЦикла;
        Запись.Вставить("components", Компоненты);
        Результат.Добавить(Запись);
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция ВыгрузитьСправочник(Имя)
    Результат = Новый Массив;
    Выборка = Справочники[Имя].Выбрать();
    Пока Выборка.Следующий() Цикл
        Запись = Новый Структура;
        Запись.Вставить("ref", Идентификатор(Выборка.Ссылка));
        Запись.Вставить("code", Выборка.Код);
        Запись.Вставить("name", Выборка.Наименование);
        Запись.Вставить("deleted", Выборка.ПометкаУдаления);
        Результат.Добавить(Запись);
    КонецЦикла;
    Возврат Результат;
КонецФункции

Процедура СохранитьПромежуточныйРезультат(Результат, Этап)
    Результат.Вставить("last_completed_stage", Этап);
    Запись = Новый ЗаписьJSON;
    Запись.ОткрытьФайл("__OUTPUT_PATH__.partial.json");
    ЗаписатьJSON(Запись, Результат);
    Запись.Закрыть();
КонецПроцедуры

Процедура ВыполнитьЭкспорт()
    Результат = Новый Структура;
    Результат.Вставить("schema_version", 1);
    Результат.Вставить("configuration", Метаданные.Имя);
    Результат.Вставить("configuration_version", Метаданные.Версия);
    Результат.Вставить("units", ВыгрузитьЕдиницы());
    СохранитьПромежуточныйРезультат(Результат, "units");
    Результат.Вставить("items", ВыгрузитьНоменклатуру());
    СохранитьПромежуточныйРезультат(Результат, "items");
    Результат.Вставить("warehouses", ВыгрузитьСправочник("Склады"));
    СохранитьПромежуточныйРезультат(Результат, "warehouses");
    Результат.Вставить("departments", ВыгрузитьСправочник("ПодразделенияОрганизаций"));
    СохранитьПромежуточныйРезультат(Результат, "departments");
    Результат.Вставить("recipes", ВыгрузитьСпецификации());
    Результат.Удалить("last_completed_stage");
    Запись = Новый ЗаписьJSON;
    Запись.ОткрытьФайл("__OUTPUT_PATH__");
    ЗаписатьJSON(Запись, Результат);
    Запись.Закрыть();
КонецПроцедуры

Попытка
    ВыполнитьЭкспорт();
Исключение
    Ошибка = Новый ТекстовыйДокумент;
    Ошибка.УстановитьТекст(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    Ошибка.Записать("__OUTPUT_PATH__.error.txt", КодировкаТекста.UTF8);
    ВызватьИсключение;
КонецПопытки;
